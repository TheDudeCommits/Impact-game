# Copy to .env.local and change what you need. Every setting has a local default, so none is required to play locally.

# --- the page (Vite reads VITE_* at build and in the dev server) ---
# The match server the page connects to. Default: this page's host on port 2567 (the server started by `npm run server`).
# VITE_MATCH_SERVER=https://match.example.com
# The accounts/economy API, if it is served apart from the match server. Default: VITE_MATCH_SERVER.
# VITE_ECONOMY_SERVER=https://match.example.com
# Where the game is served: the canonical link, share links and the legal pages. Default: http://localhost:5173
# VITE_SITE_URL=https://game.example.com
# Who hosts the game server, as the privacy page names it. Default: not named.
# VITE_SERVER_HOST=Example Cloud (servers in Somewhere)
# A Discord invite for the party page's Discord button. Default: no button.
# VITE_DISCORD_INVITE=https://discord.gg/xxxxxxx
# A host that serves /join/<code> invite preview pages. Default: none (invites are #room= links on the page's address).
# VITE_JOIN_HOST=game.example.com

# --- the match server (npm run server) ---
# PORT=2567
# Where accounts, ledgers and progress are kept. Default: memory only (nothing survives a restart).
# DATA_DIR=./data
# Extra origins (comma-separated, exact) allowed to call the accounts API and error reports. localhost is always allowed.
# ECONOMY_ORIGINS=https://game.example.com
# A Privy app id turns sign-in on. Default: sign-in off (guest accounts only).
# PRIVY_APP_ID=
# A token for the admin grant route. Default: off.
# ECONOMY_ADMIN_TOKEN=
